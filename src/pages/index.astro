---
import Base from '../layouts/Base.astro';
import topics from '../data/topics.json';
import profile from '../data/profile.json';
import {postCover} from '../lib/post-cover.mjs';
import { site, siteSummary } from '../lib/site';
import { safeBookingUrl, homeTitle, professionalDetails } from '../lib/professional.mjs';
import { businessJsonLd, jsonLdText } from '../lib/business-schema.mjs';
import { withBase } from '../lib/withBase';
import { getCollection } from 'astro:content';
import type { HomeProps, HomePost, HomeConstellation } from '../lib/home';
import { vocabFor, topicName, SEED_TAGLINE } from '../lib/vocab';
import BlockPage from '../components/BlockPage.astro';
import { blockPage } from '../lib/pages/site-pages';
// A Home page built in Chapbook's page editor replaces the theme's own home page.
const homeBlocks = blockPage('home');

// --- per-archetype homepages ---------------------------------------------
// Every theme's `hero` archetype (src/data/themes.json) selects a STRUCTURALLY
// distinct first screen. The interlocked-rings WebGL hero (archetype `rings`) is
// reserved for `observatory`. Adding a theme with a new archetype = add its
// Home component in src/components/home/ + its archetype in src/lib/blog-homes.mjs.
// Only the website's own look's Home is built in (astro.config.mjs, `oneHome`), so a page
// never waits for the other looks' home styles.
import Home from 'virtual:chapbook-home';

// The active blog theme (must match Base.astro's data-blog-theme resolution).
const blogTheme = site.defaultTheme || 'observatory';

// --- shape the collection ONCE for whichever Home renders ------------------
const rawPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const vocab = vocabFor(blogTheme);
const broad = new Map(topics.map((t) => [t.tag, t]));
const coverModules = import.meta.glob('../content/blog/_images/**/*.{jpg,jpeg,png,webp,avif,gif,svg}', {eager:true,query:'?url',import:'default'});
const coverAssets = Object.fromEntries(Object.entries(coverModules).map(([path,url])=>[path.replace('../content/blog/',''),url]));
const posts: HomePost[] = rawPosts.map((p) => {
  const topicTag = p.data.tags.find((t) => broad.has(t));
  const bt = topicTag ? broad.get(topicTag)! : null;
  return {
    slug: p.slug,
    image: postCover(p.data,p.body,coverAssets,import.meta.env.BASE_URL),
    href: withBase(`/blog/${p.slug}/`),
    title: p.data.title,
    description: p.data.description,
    date: p.data.date,
    tags: p.data.tags,
    accent: p.data.accent,
    glyph: p.data.glyph,
    topic: bt ? { name: topicName(vocab, bt.tag, bt.name), color: bt.color, tag: bt.tag } : null,
    interactive: p.data.tags.includes('interactive'),
    readMins: Math.max(1, Math.round((p.body || '').split(/\s+/).filter(Boolean).length / 200)),
  };
});

const tagCount = (tag: string) => posts.filter((p) => p.tags.includes(tag)).length;
const constellations: HomeConstellation[] = topics.map((t) => ({
  name: topicName(vocab, t.tag, t.name),
  subtitle: t.subtitle,
  tag: t.tag,
  color: t.color,
  blurb: (t as any).blurb ?? '',
  count: tagCount(t.tag),
  href: withBase(`/c/${t.tag}/`),
}));

// The user's own tagline always wins; the theme's demo tagline only fills in for the
// untouched seed placeholder so each catalogue preview reads in its own voice.
const tagline = site.tagline && site.tagline !== SEED_TAGLINE ? site.tagline : (vocab.tagline || site.tagline);

const homeProps: HomeProps = {
  posts,
  topics: constellations,
  masthead: site.masthead,
  tagline,
  name: site.name,
  postsHref: withBase('/posts/'),
  aboutHref: withBase('/about/'),
  observatoryHref: withBase('/observatory/'),
  newsletterEndpoint: safeBookingUrl(site.newsletter.endpoint),
  postsTitle: vocab.postsTitle,
  topicsLabel: vocab.topicsLabel,
  aboutLabel: vocab.aboutLabel,
};

// --- SEO/AEO: WebSite + Person JSON-LD for the home page ---
const cleanSocials = Object.values(site.socials).filter((u) => typeof u === 'string' && /^https:\/\//.test(u));
const blogJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.masthead,
      description: siteSummary || undefined,
      inLanguage: 'en-GB',
      publisher: { '@id': `${site.url}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.name,
      jobTitle: profile.role === 'What you do' ? undefined : (profile.role || undefined),
      url: `${site.url}/`,
      description: profile.tagline === 'A short line about you and this blog.' ? (siteSummary || undefined) : profile.tagline,
      worksFor: { '@type': 'Organization', name: profile.trust },
      ...(cleanSocials.length ? { sameAs: cleanSocials } : {}),
    },
  ],
};
// A business website says what kind of business it is, where, when it is open and how to reach
// it, from its own details (src/lib/business-schema.mjs); a blog or personal website keeps the
// WebSite and Person above.
const openingPic = homeBlocks?.blocks?.find((b: any) => b.type === 'hero')?.data?.picture?.src;
const businessLd = businessJsonLd({
  site, professional: professionalDetails(site.professional), url: new URL(withBase('/'), Astro.site).href.replace(/\/$/, ''),
  image: typeof openingPic === 'string' && /^\/site-images\//.test(openingPic) ? new URL(withBase(openingPic), Astro.site).href : '',
  description: homeBlocks?.description || siteSummary || '',
});
const jsonLd = businessLd || blogJsonLd;
---
{homeBlocks ? (
  <BlockPage page={homeBlocks} title={homeTitle(site)} description={homeBlocks.description || undefined}>
    <script type="application/ld+json" set:html={jsonLdText(jsonLd)} />
  </BlockPage>
) : (
<Base title={site.masthead} progress>
  <script type="application/ld+json" set:html={jsonLdText(jsonLd)} />
  <Home {...homeProps} />
</Base>
)}
