---
// ARCHETYPE · photo-pile — polaroid (Instant Photo).
// A scattered pile of instant photos on a soft grey desk: 3–4 polaroid frames (white
// frame, thick bottom lip, the photo = a colour plate from the post accent) rotated and
// overlapping, each captioned by hand on the lip. Below the pile, a tidy grid of small
// caption-cards covers the rest. On mobile the pile relaxes into a neat vertical stack —
// no horizontal overflow, ever. Identity = a casual pile of rotated polaroids.
import type { HomeProps } from '../../lib/home';
import { fmtDate } from '../../lib/home';

const { posts, topics, masthead, tagline, postsHref, postsTitle } =
  Astro.props as HomeProps;

const pile = posts.slice(0, 4);
const cards = posts.slice(4);
const liveTopics = topics.filter((t) => t.count > 0);
---
<section class="pp">
  <header class="pp-head">
    <p class="pp-eyebrow">Latest snapshots</p>
    <h1 class="pp-word">{masthead}</h1>
    <p class="pp-tag">{tagline}</p>
  </header>

  <div class="pp-stage" role="list" aria-label={`${postsTitle} — latest`}>
    {pile.map((p) => (
      <a class="pp-polaroid" href={p.href} role="listitem" style={`--pa:${p.accent}`}>
        <span class="pp-photo" aria-hidden="true"></span>
        <span class="pp-lip">
          <span class="pp-hand">{p.title}</span>
          <span class="pp-date">
            <time datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
            <span class="pp-dot" aria-hidden="true">·</span>
            <span>{p.readMins} min</span>
          </span>
        </span>
      </a>
    ))}
  </div>

  {cards.length > 0 && (
    <div class="pp-more">
      <p class="pp-more-label">More from the shoebox</p>
      <div class="pp-cards">
        {cards.map((p) => (
          <a class="pp-card" href={p.href} style={`--pa:${p.accent}`}>
            <span class="pp-card-chip" aria-hidden="true"></span>
            <span class="pp-card-body">
              <span class="pp-card-title">{p.title}</span>
              <span class="pp-card-meta">
                {p.topic && <><span class="pp-card-topic">{p.topic.name}</span><span class="pp-dot" aria-hidden="true">·</span></>}
                <time datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
                <span class="pp-dot" aria-hidden="true">·</span>
                <span>{p.readMins} min</span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  )}

  <footer class="pp-foot">
    <ul class="pp-topics">
      {liveTopics.map((t) => (
        <li><a href={t.href} style={`--c:${t.color}`}>{t.name}</a></li>
      ))}
    </ul>
    <a class="pp-all" href={postsHref}>All {postsTitle.toLowerCase()} →</a>
  </footer>
</section>

<style>
  .pp {
    --hand: 'Fredoka', var(--font-body, sans-serif);
    --desk-ink: #26241f;
    --desk-faint: #615e55;
    --retro: #3a7ca5;
    width: min(1120px, 100% - 2.4rem);
    margin-inline: auto;
    padding: clamp(1.2rem, 3vw, 2.2rem) 0 clamp(2rem, 5vw, 3.5rem);
    overflow-x: clip;                    /* guard against rotated overhang */
    color: var(--desk-ink);
  }

  .pp-head { max-width: 60ch; margin-bottom: clamp(0.4rem, 2vw, 1rem); }
  .pp-eyebrow {
    font-family: var(--hand); font-weight: 500; font-size: 0.9rem;
    letter-spacing: 0.04em; color: var(--retro);
  }
  .pp-word {
    font-family: var(--font-display, sans-serif); font-weight: 500;
    font-size: clamp(1.9rem, 5vw, 3rem); letter-spacing: -0.015em; line-height: 1;
    color: var(--desk-ink); margin: 0.25rem 0 0.4rem;
  }
  .pp-tag { font-family: var(--font-body, sans-serif); font-size: 1rem; line-height: 1.5; color: var(--desk-faint); max-width: 54ch; }

  /* ---------- the pile ---------- */
  .pp-stage {
    position: relative;
    min-height: clamp(370px, 52vh, 520px);
    margin: clamp(0.5rem, 2vw, 1.4rem) auto 0;
    max-width: 780px;
  }
  .pp-polaroid {
    position: absolute;
    width: clamp(184px, 30vw, 252px);
    background: #fff;
    padding: 12px 12px 0;
    border-radius: 2px;
    box-shadow: 0 12px 26px rgba(38, 36, 31, 0.22), 0 2px 6px rgba(38, 36, 31, 0.14);
    cursor: pointer;
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg));
    transform-origin: center;
  }
  .pp-polaroid:nth-child(1) { left: 50%; top: 49%; z-index: 4; --rot: -4deg; }
  .pp-polaroid:nth-child(2) { left: 30%; top: 43%; z-index: 3; --rot: -11deg; }
  .pp-polaroid:nth-child(3) { left: 69%; top: 47%; z-index: 2; --rot: 8deg; }
  .pp-polaroid:nth-child(4) { left: 47%; top: 64%; z-index: 1; --rot: 4deg; }

  .pp-photo {
    display: block;
    aspect-ratio: 1 / 1;
    background:
      linear-gradient(160deg,
        color-mix(in srgb, var(--pa) 58%, #e3ebef) 0%,
        color-mix(in srgb, var(--pa) 32%, #cdd8de) 100%);
    box-shadow: inset 0 0 0 1px rgba(38, 36, 31, 0.06);
  }
  .pp-lip { display: block; padding: 0.7rem 0.25rem 1.05rem; }
  .pp-hand {
    display: block;
    font-family: var(--hand);
    font-weight: 500; font-size: 1.06rem; line-height: 1.16; letter-spacing: 0.005em;
    color: var(--desk-ink);
    overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .pp-date {
    display: flex; align-items: baseline; gap: 0.35rem;
    margin-top: 0.4rem;
    font-family: var(--font-display, sans-serif);
    font-size: 0.72rem; color: var(--desk-faint);
    font-variant-numeric: tabular-nums;
  }
  .pp-dot { color: var(--retro); }

  /* motion: straighten + lift on hover (guarded) */
  @media (prefers-reduced-motion: no-preference) {
    .pp-polaroid { transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.3s ease; }
    .pp-polaroid:hover {
      transform: translate(-50%, -50%) rotate(0deg) translateY(-8px);
      z-index: 5;
      box-shadow: 0 24px 48px rgba(38, 36, 31, 0.3), 0 4px 10px rgba(38, 36, 31, 0.16);
    }
  }
  /* keyboard focus lifts too, without depending on motion */
  .pp-polaroid:focus-visible { z-index: 5; box-shadow: 0 24px 48px rgba(38, 36, 31, 0.3), 0 4px 10px rgba(38, 36, 31, 0.16); }

  /* ---------- caption-cards for the rest ---------- */
  .pp-more { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .pp-more-label {
    font-family: var(--hand); font-weight: 500; font-size: 1rem; color: var(--desk-ink);
    margin-bottom: 0.9rem;
    display: flex; align-items: center; gap: 0.7rem;
  }
  .pp-more-label::after { content: ""; flex: 1; height: 1px; background: rgba(38, 36, 31, 0.16); }
  .pp-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(240px, 40vw, 300px), 1fr));
    gap: 0.9rem;
  }
  .pp-card {
    display: flex; align-items: center; gap: 0.9rem;
    background: #fff;
    border: 1px solid rgba(38, 36, 31, 0.12);
    border-radius: 2px;
    padding: 0.7rem;
    box-shadow: 0 6px 16px rgba(38, 36, 31, 0.1);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .pp-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 26px rgba(38, 36, 31, 0.16);
    border-color: rgba(38, 36, 31, 0.24);
  }
  .pp-card-chip {
    flex: none; width: 58px; height: 58px; border-radius: 1px;
    background: linear-gradient(160deg,
      color-mix(in srgb, var(--pa) 58%, #e3ebef), color-mix(in srgb, var(--pa) 32%, #cdd8de));
    box-shadow: inset 0 0 0 1px rgba(38, 36, 31, 0.06);
  }
  .pp-card-body { min-width: 0; }
  .pp-card-title {
    display: block;
    font-family: var(--font-display, sans-serif); font-weight: 500; font-size: 1rem; line-height: 1.2;
    letter-spacing: -0.005em; color: var(--desk-ink);
    overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .pp-card:hover .pp-card-title { color: var(--retro); }
  .pp-card-meta {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem;
    margin-top: 0.3rem;
    font-family: var(--font-display, sans-serif); font-size: 0.72rem; color: var(--desk-faint);
    font-variant-numeric: tabular-nums;
  }
  .pp-card-topic { color: var(--retro); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.64rem; font-weight: 600; }

  /* ---------- footer ---------- */
  .pp-foot {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0.8rem 1.5rem;
    margin-top: clamp(1.6rem, 4vw, 2.4rem);
    padding-top: 1.1rem;
    border-top: 1px solid rgba(38, 36, 31, 0.16);
  }
  .pp-topics { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  .pp-topics a {
    display: inline-flex; align-items: baseline; gap: 0.4rem;
    font-family: var(--font-display, sans-serif);
    font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--desk-faint); cursor: pointer; transition: color 0.2s ease;
  }
  .pp-topics a::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c, var(--retro)); align-self: center; }
  .pp-topics a:hover { color: var(--desk-ink); }
  .pp-all {
    font-family: var(--font-display, sans-serif);
    font-size: 0.74rem; letter-spacing: 0.06em; color: var(--retro);
    cursor: pointer; white-space: nowrap; transition: opacity 0.2s ease;
  }
  .pp-all:hover { opacity: 0.7; }

  /* ---------- mobile: the pile relaxes into a tidy stack ---------- */
  @media (max-width: 560px) {
    .pp-stage {
      position: static; min-height: 0; max-width: none;
      display: flex; flex-direction: column; align-items: center; gap: 1.3rem;
    }
    .pp-polaroid {
      position: static; transform: rotate(var(--rot, 0deg));
      width: min(250px, 80vw);
    }
    .pp-polaroid:nth-child(1) { --rot: -2deg; }
    .pp-polaroid:nth-child(2) { --rot: 2.5deg; }
    .pp-polaroid:nth-child(3) { --rot: -2.5deg; }
    .pp-polaroid:nth-child(4) { --rot: 1.5deg; }
    .pp-cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) and (prefers-reduced-motion: no-preference) {
    .pp-polaroid:hover { transform: rotate(0deg) translateY(-6px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pp-card { transition: none; }
  }
</style>
