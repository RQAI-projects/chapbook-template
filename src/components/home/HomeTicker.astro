---
// ARCHETYPE · ticker — gazette.
// An old-world civic newsletter, buttoned up: a BOXED nameplate ruled in navy double
// rules with Vol./date in the corners; directly beneath it a slim HEADLINE TICKER
// strip — the latest titles scrolling in one row, parted by navy diamonds, and fully
// reduced-motion-safe (motion off → the row simply wraps, never a dead empty strip);
// then a DENSE two-column dateline INDEX of every post, hairline separated. Distinct at
// a glance from the broadsheet: boxed masthead + live ticker, not a lead-story grid.
import type { HomeProps } from '../../lib/home';
import { fmtDate, fmtDateLong, pad2 } from '../../lib/home';

const { posts, masthead, tagline, postsHref, postsTitle } = Astro.props as HomeProps;
const editionDate = posts[0] ? fmtDateLong(posts[0].date) : '';
const ticker = posts.slice(0, 12);
// scale the loop to the number of headlines so speed stays even for short/long lists.
const tickerDur = `${Math.max(20, ticker.length * 3.4).toFixed(0)}s`;
---
<section class="tk">
  <div class="container">
    <!-- boxed nameplate -->
    <header class="tk-plate">
      <div class="tk-plate-top">
        <span class="tk-corner">Vol. MMXXVI · No. {pad2(posts.length)}</span>
        <span class="tk-corner tk-corner-r">{editionDate}</span>
      </div>
      <a class="tk-wordmark" href="/">{masthead}</a>
      <p class="tk-tagline">{tagline}</p>
    </header>

    <!-- headline ticker -->
    {ticker.length > 0 && (
      <div class="tk-ticker" aria-label="Latest headlines">
        <div class="tk-track" style={`--tk-dur:${tickerDur}`}>
          {ticker.map((p) => (
            <a class="tk-tick" href={p.href}>
              <span>{p.title}</span>
              <svg class="tk-diamond" width="7" height="7" viewBox="0 0 10 10" aria-hidden="true"><path d="M5 0 10 5 5 10 0 5Z" /></svg>
            </a>
          ))}
          {ticker.map((p) => (
            <a class="tk-tick tk-dup" href={p.href} tabindex="-1" aria-hidden="true">
              <span>{p.title}</span>
              <svg class="tk-diamond" width="7" height="7" viewBox="0 0 10 10" aria-hidden="true"><path d="M5 0 10 5 5 10 0 5Z" /></svg>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- dense dateline index -->
    <section class="tk-index-wrap" aria-label={postsTitle}>
      <div class="tk-index-head">
        <h2>{postsTitle}</h2>
        <a class="tk-all" href={postsHref}>All {postsTitle.toLowerCase()} →</a>
      </div>
      <ul class="tk-index">
        {posts.map((p) => (
          <li class="tk-entry">
            <a class="tk-entry-link" href={p.href}>
              <span class="tk-entry-meta">
                <time class="tk-date" datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
                {p.topic && <span class="tk-etopic">{p.topic.name}</span>}
                <span class="tk-eread">{p.readMins} min</span>
              </span>
              <span class="tk-etitle">{p.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</section>

<style>
  .tk { padding-block: clamp(1.4rem, 3.5vw, 2.6rem) 4.5rem; }
  .container { width: min(1120px, 100% - 2.5rem); }

  /* ---- boxed nameplate ---- */
  .tk-plate {
    border: 3px double var(--accent);
    padding: clamp(0.7rem, 2vw, 1.1rem) clamp(1rem, 3vw, 2rem) clamp(1rem, 2.6vw, 1.4rem);
    text-align: center;
  }
  .tk-plate-top {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 0.6rem 1rem; flex-wrap: wrap;
    padding-bottom: 0.55rem; margin-bottom: 0.7rem;
    border-bottom: 3px double var(--line-strong);
  }
  .tk-corner {
    font-family: var(--font-display); font-variant: small-caps; letter-spacing: 0.08em;
    font-size: 0.76rem; color: var(--ink-faint); font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tk-corner-r { text-align: right; }
  .tk-wordmark {
    display: block; font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.9rem, 8vw, 4.6rem); line-height: 1; letter-spacing: 0.01em;
    color: var(--ink); cursor: pointer; overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }
  .tk-wordmark:hover { color: var(--accent); }
  .tk-tagline {
    margin: 0.7rem 0 0; font-family: var(--font-display); font-variant: small-caps;
    letter-spacing: 0.14em; font-size: 0.9rem; color: var(--ink-dim);
  }

  /* ---- headline ticker strip ---- */
  .tk-ticker {
    margin-top: 0.9rem; overflow: hidden;
    border-top: 3px double var(--accent); border-bottom: 3px double var(--accent);
  }
  .tk-track {
    display: flex; width: max-content; align-items: center;
    animation: tk-scroll var(--tk-dur, 40s) linear infinite;
  }
  .tk-ticker:hover .tk-track,
  .tk-ticker:focus-within .tk-track { animation-play-state: paused; }
  .tk-tick {
    display: inline-flex; align-items: center; gap: 1.3rem;
    padding: 0.5rem 0; margin-right: 1.3rem;
    font-family: var(--font-display); font-weight: 600; font-size: 0.98rem;
    color: var(--ink); white-space: nowrap; cursor: pointer;
    transition: color 0.2s ease;
  }
  .tk-tick:hover { color: var(--accent); }
  .tk-diamond { flex: none; fill: var(--accent); }

  @keyframes tk-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ---- dense dateline index ---- */
  .tk-index-wrap { margin-top: clamp(1.8rem, 4vw, 2.8rem); }
  .tk-index-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; padding-bottom: 0.4rem; border-bottom: 3px double var(--line-strong);
  }
  .tk-index-head h2 {
    margin: 0; font-family: var(--font-display); font-weight: 700;
    font-variant: small-caps; letter-spacing: 0.06em; font-size: 1.2rem; color: var(--ink);
  }
  .tk-all {
    font-family: var(--font-display); font-variant: small-caps; letter-spacing: 0.06em;
    font-size: 0.92rem; color: var(--accent); cursor: pointer; white-space: nowrap;
    transition: color 0.2s ease;
  }
  .tk-all:hover { text-decoration: underline; }

  .tk-index {
    list-style: none; margin: 0.7rem 0 0; padding: 0;
    columns: 2; column-gap: 2.4rem; column-rule: 1px solid var(--line);
  }
  .tk-entry { break-inside: avoid; border-bottom: 1px solid var(--line); }
  .tk-entry-link {
    display: block; padding: 0.6rem 0.25rem; cursor: pointer;
    transition: background 0.2s ease;
  }
  .tk-entry-link:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .tk-entry-meta {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.25rem 0.7rem;
    font-family: var(--font-display); font-variant: small-caps; letter-spacing: 0.05em;
    font-size: 0.72rem; color: var(--ink-faint);
  }
  .tk-date { color: var(--accent); font-variant-numeric: tabular-nums; }
  .tk-etopic { color: var(--ink-faint); }
  .tk-eread { color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .tk-etitle {
    display: block; margin-top: 0.15rem;
    font-family: var(--font-display); font-weight: 600; font-size: 1.02rem;
    line-height: 1.22; color: var(--ink); transition: color 0.2s ease;
  }
  .tk-entry-link:hover .tk-etitle { color: var(--accent); }

  @media (max-width: 640px) {
    .tk-index { columns: 1; column-rule: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tk-ticker { overflow: visible; }
    .tk-track {
      animation: none; width: auto; flex-wrap: wrap; white-space: normal;
      column-gap: 0.4rem;
    }
    .tk-tick { white-space: normal; }
    .tk-dup { display: none; }
    .tk-wordmark, .tk-tick, .tk-all, .tk-entry-link, .tk-etitle { transition: none; }
  }
</style>
