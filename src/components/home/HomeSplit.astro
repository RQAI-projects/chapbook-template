---
// ARCHETYPE · split — Graphite (architecture-studio split-screen).
// A fixed 2-column reading room. The LEFT rail is sticky: wordmark, one studio about line,
// and the "Disciplines" — the topic list with counts. The RIGHT column scrolls independently:
// a monochrome run of hairline-separated post rows (index no. + title + one-line description +
// topic · min · date), each lifting to a restrained steel highlight on hover. A genuinely
// handsome dark home — cool greys, crisp hairlines, confident medium-weight type; no colour.
import type { HomeProps } from '../../lib/home';
import { fmtDate, pad2 } from '../../lib/home';

const { posts, topics, masthead, name, postsHref, postsTitle, topicsLabel } =
  Astro.props as HomeProps;
const disciplines = topics.filter((t) => t.count > 0);
---
<section class="split">
  <div class="split-grid">
    <aside class="split-rail">
      <div class="split-rail-inner">
        <a class="split-mark" href="/">{masthead}</a>
        <p class="split-about">{name} — writing &amp; studio notes.</p>

        <nav class="split-disc" aria-label={topicsLabel}>
          <p class="split-disc-label">{topicsLabel}</p>
          <ul>
            {disciplines.map((t) => (
              <li>
                <a href={t.href}>
                  <span class="split-disc-name">{t.name}</span>
                  <span class="split-disc-count">{pad2(t.count)}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <a class="split-rail-all" href={postsHref}>
          <span>All {postsTitle.toLowerCase()}</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </aside>

    <div class="split-list">
      <ol>
        {posts.map((p, i) => (
          <li class="split-row">
            <a href={p.href}>
              <span class="split-idx">{pad2(i + 1)}</span>
              <span class="split-row-body">
                <span class="split-row-title">{p.title}</span>
                {p.description && <span class="split-row-desc">{p.description}</span>}
                <span class="split-row-meta">
                  {p.topic && <span class="split-row-topic">{p.topic.name}</span>}
                  {p.topic && <span class="split-sep" aria-hidden="true">·</span>}
                  <span>{p.readMins} min</span>
                  <span class="split-sep" aria-hidden="true">·</span>
                  <time datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
                </span>
              </span>
              <svg class="split-row-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .split { padding-block: clamp(1.4rem, 4vh, 2.6rem) 4rem; }
  .split-grid {
    width: min(1200px, 100% - 3rem);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
    align-items: start;
    gap: 0 clamp(1.6rem, 4vw, 3.4rem);
  }

  /* ---- LEFT: sticky studio rail ---- */
  .split-rail-inner {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    padding-top: 0.4rem;
  }
  .split-mark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 1.95rem);
    letter-spacing: -0.015em;
    line-height: 1.05;
    color: var(--ink);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .split-mark:hover { color: #fff; }
  .split-about {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-dim);
    max-width: 30ch;
  }

  .split-disc-label {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-bottom: 0.7rem;
    margin-bottom: 0.2rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .split-disc ul { list-style: none; margin: 0; padding: 0; }
  .split-disc li { border-bottom: 1px solid var(--line); }
  .split-disc a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.62rem 0;
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: var(--ink-dim);
    cursor: pointer;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }
  .split-disc a:hover { color: var(--ink); padding-left: 0.35rem; }
  .split-disc-count {
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    color: var(--ink-faint);
    transition: color 0.2s ease;
  }
  .split-disc a:hover .split-disc-count { color: var(--accent); }

  .split-rail-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.86rem;
    color: var(--ink-dim);
    cursor: pointer;
    transition: color 0.2s ease, gap 0.2s ease;
  }
  .split-rail-all:hover { color: var(--ink); gap: 0.6rem; }

  /* ---- RIGHT: independently scrolling column of post rows ---- */
  .split-list {
    border-left: 1px solid var(--line-strong);
    padding-left: clamp(1.6rem, 4vw, 3.4rem);
    min-width: 0;
  }
  .split-list ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .split-row { border-bottom: 1px solid var(--line); }
  .split-row a {
    display: grid;
    grid-template-columns: 2.6rem 1fr auto;
    align-items: start;
    gap: 0 1.2rem;
    padding: 1.15rem 0.75rem 1.25rem;
    margin-inline: -0.75rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .split-row a:hover { background: rgba(174, 183, 194, 0.06); }

  .split-idx {
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: 0.82rem;
    color: var(--ink-faint);
    padding-top: 0.25rem;
    transition: color 0.2s ease;
  }
  .split-row a:hover .split-idx { color: var(--accent); }

  .split-row-body { min-width: 0; }
  .split-row-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.12rem, 1.8vw, 1.38rem);
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--ink);
    text-wrap: pretty;
    transition: color 0.2s ease;
  }
  .split-row a:hover .split-row-title { color: #fff; }
  .split-row-desc {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--ink-dim);
    max-width: 64ch;
  }
  .split-row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.5rem;
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
  }
  .split-row-topic { text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-dim); }
  .split-sep { color: var(--line-strong); }

  .split-row-arrow {
    align-self: center;
    color: var(--ink-faint);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }
  .split-row a:hover .split-row-arrow { opacity: 1; transform: none; color: var(--accent); }

  /* ---- mobile: rail stacks on top (static), list flows below ---- */
  @media (max-width: 820px) {
    .split-grid { grid-template-columns: 1fr; gap: 2rem; }
    .split-rail-inner {
      position: static;
      top: auto;
      gap: 1.3rem;
      padding-bottom: 1.8rem;
      border-bottom: 1px solid var(--line-strong);
    }
    .split-list { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 480px) {
    .split-row a { grid-template-columns: 2rem 1fr; }
    .split-row-arrow { display: none; }
  }
</style>
