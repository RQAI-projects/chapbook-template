---
// ARCHETYPE · lead-grid — gallery (White Cube).
// IMAGE-LED. A full-bleed LEAD PLATE (latest post) = a large duotone colour-field
// built from the post's accent, with a minimal gallery-label placard bottom-left.
// Then an edge-to-edge uniform wall of colour plates (the rest), each a tiny museum
// placard that reveals/lifts on hover. Chrome is near-invisible: white walls, near-
// black labels. The WORK (colour) leads; type stays a quiet caption.
import type { HomeProps } from '../../lib/home';
import { fmtDate } from '../../lib/home';

const { posts, topics, masthead, tagline, postsHref, postsTitle, topicsLabel } =
  Astro.props as HomeProps;

const lead = posts[0];
const wall = posts.slice(1);
const liveTopics = topics.filter((t) => t.count > 0);
---
<section class="lg" aria-label={`${masthead} — ${postsTitle}`}>
  {lead && (
    <a class="lg-lead" href={lead.href} style={`--pa:${lead.accent}`}>
      <span class="lg-lead-plate" aria-hidden="true"></span>
      <span class="lg-lead-label">
        <span class="lg-lead-title">{lead.title}</span>
        <span class="lg-lead-sub">
          {lead.topic && <span class="lg-lead-topic">{lead.topic.name}</span>}
          <time datetime={lead.date.toISOString()}>{fmtDate(lead.date)}</time>
        </span>
      </span>
    </a>
  )}

  <div class="lg-wall">
    {wall.map((p) => (
      <a class="lg-cell" href={p.href} style={`--pa:${p.accent}`}>
        <span class="lg-plate" aria-hidden="true"></span>
        <span class="lg-cap">
          <span class="lg-cap-t">{p.title}</span>
          <span class="lg-cap-m">
            {p.topic && <><span>{p.topic.name}</span><span class="lg-cap-dot" aria-hidden="true">·</span></>}
            <span>{p.readMins} min</span>
          </span>
        </span>
      </a>
    ))}
  </div>

  <footer class="lg-foot">
    <ul class="lg-topics">
      {liveTopics.map((t) => (
        <li><a href={t.href} style={`--c:${t.color}`}>{t.name}</a></li>
      ))}
    </ul>
    <a class="lg-all" href={postsHref}>All {postsTitle.toLowerCase()} →</a>
  </footer>
</section>

<style>
  .lg {
    /* whole component references the theme's white-cube tokens */
    --wall-ink: #14151a;
    --wall-faint: #63656e;
    background: #ffffff;
    width: 100%;
    padding: 0 0 clamp(2rem, 5vw, 3.5rem);
  }

  /* ---------- full-bleed lead plate ---------- */
  .lg-lead {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 21 / 9;
    min-height: clamp(320px, 52vh, 560px);
    overflow: hidden;
    cursor: pointer;
    isolation: isolate;
  }
  .lg-lead-plate {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(132% 120% at 82% 10%,
        color-mix(in srgb, var(--pa) 48%, #ffffff) 0%, transparent 52%),
      linear-gradient(148deg,
        color-mix(in srgb, var(--pa) 90%, #14151a) 0%,
        color-mix(in srgb, var(--pa) 60%, #14151a) 48%,
        color-mix(in srgb, var(--pa) 88%, #000000) 100%);
    transition: transform 0.3s ease;
  }
  .lg-lead-label {
    position: absolute;
    left: clamp(1rem, 3vw, 2.6rem);
    bottom: clamp(1rem, 3vw, 2.6rem);
    background: #ffffff;
    padding: 0.8rem 1.05rem 0.85rem;
    max-width: min(84%, 34ch);
    box-shadow: 0 2px 14px rgba(20, 21, 26, 0.14);
    z-index: 1;
  }
  .lg-lead-title {
    display: block;
    font-family: var(--font-display, sans-serif);
    font-weight: 500;
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    line-height: 1.16;
    letter-spacing: -0.015em;
    color: var(--wall-ink);
  }
  .lg-lead-sub {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 0.9rem;
    margin-top: 0.5rem;
    font-family: var(--font-display, sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--wall-faint);
    font-variant-numeric: tabular-nums;
  }
  .lg-lead-topic { color: var(--pa); filter: saturate(0.55) brightness(0.72); font-weight: 600; }

  /* ---------- edge-to-edge wall of plates ---------- */
  .lg-wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(150px, 22vw, 210px), 1fr));
    gap: 2px;
    background: #ffffff;          /* gap shows as hairline white frames */
    margin-top: 2px;
  }
  .lg-cell {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    cursor: pointer;
    isolation: isolate;
  }
  .lg-plate {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 120% at 78% 16%,
        color-mix(in srgb, var(--pa) 32%, #ffffff) 0%, transparent 56%),
      linear-gradient(150deg,
        color-mix(in srgb, var(--pa) 74%, #ffffff) 0%,
        color-mix(in srgb, var(--pa) 36%, #ffffff) 100%);
    transition: transform 0.25s ease, filter 0.25s ease;
  }
  .lg-cap {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.5rem;
    background: #ffffff;
    padding: 0.55rem 0.65rem 0.6rem;
    box-shadow: 0 2px 10px rgba(20, 21, 26, 0.12);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .lg-cell:hover .lg-cap,
  .lg-cell:focus-visible .lg-cap,
  .lg-cell:focus-within .lg-cap { opacity: 1; transform: translateY(0); }
  .lg-cell:hover .lg-plate { transform: scale(1.03); filter: saturate(1.08); }
  .lg-cap-t {
    display: block;
    font-family: var(--font-display, sans-serif);
    font-weight: 500;
    font-size: 0.86rem;
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: var(--wall-ink);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .lg-cap-m {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    margin-top: 0.3rem;
    font-family: var(--font-display, sans-serif);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--wall-faint);
    font-variant-numeric: tabular-nums;
  }
  .lg-cap-dot { color: var(--wall-faint); }

  /* ---------- whisper-quiet footer ---------- */
  .lg-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
    width: min(1180px, 100% - 3rem);
    margin: clamp(1.6rem, 4vw, 2.6rem) auto 0;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(20, 21, 26, 0.14);
  }
  .lg-topics { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.3rem; }
  .lg-topics a {
    display: inline-flex; align-items: baseline; gap: 0.4rem;
    font-family: var(--font-display, sans-serif);
    font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--wall-faint); cursor: pointer; transition: color 0.2s ease;
  }
  .lg-topics a::before {
    content: ""; width: 8px; height: 8px; border-radius: 50%;
    background: var(--c, var(--wall-ink)); align-self: center;
  }
  .lg-topics a:hover { color: var(--wall-ink); }
  .lg-all {
    font-family: var(--font-display, sans-serif);
    font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--wall-ink); cursor: pointer; white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .lg-all:hover { opacity: 0.6; }

  @media (max-width: 560px) {
    .lg-lead { aspect-ratio: 4 / 5; }
    .lg-wall { grid-template-columns: repeat(2, 1fr); }
    /* on small screens the reveal is fiddly → keep captions steady + readable */
    .lg-cap { position: static; opacity: 1; transform: none; box-shadow: none; padding: 0.5rem 0.15rem 0.2rem; background: transparent; }
    .lg-cell { aspect-ratio: auto; }
    .lg-plate { position: static; display: block; aspect-ratio: 1 / 1; }
    .lg-cell { display: flex; flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lg-cap { opacity: 1; transform: none; transition: none; }
    .lg-plate, .lg-lead-plate { transition: none; }
    .lg-cell:hover .lg-plate { transform: none; }
  }
</style>
