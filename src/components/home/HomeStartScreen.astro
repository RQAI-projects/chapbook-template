---
// ARCHETYPE · start-screen — arcade.
// A DARK CRT START SCREEN. Full-bleed scanline + vignette overlay (pointer-events:none),
// a blocky pixel WORDMARK, a "PRESS START" call on the latest post with a BLINKING
// prompt, then the rest as a LEVEL-SELECT list ("LEVEL 01 — Title") with a blinking SVG
// ▶ cursor on the active row. Midnight cabinet + arcade yellow. Deliberately NOT the
// light-pastel pixel theme. Identity = an insert-coin CRT start screen.
import type { HomeProps } from '../../lib/home';
import { pad2 } from '../../lib/home';

const { posts, topics, masthead, tagline, postsHref, postsTitle, topicsLabel } =
  Astro.props as HomeProps;
const latest = posts[0];
const liveTopics = topics.filter((t) => t.count > 0);
---
<section class="ss">
  <div class="ss-crt" aria-hidden="true"></div>

  <div class="ss-inner">
    <header class="ss-hero">
      <p class="ss-coin">Insert coin</p>
      <h1 class="ss-wordmark">{masthead}</h1>
      <p class="ss-tagline">{tagline}</p>

      {latest && (
        <a class="ss-start" href={latest.href}>
          <span class="ss-start-blink">Press Start</span>
          <span class="ss-start-title">{latest.title}</span>
          <span class="ss-start-meta">
            {latest.topic && <span>{latest.topic.name}</span>}
            {latest.topic && <span aria-hidden="true"> · </span>}
            {latest.readMins} MIN
          </span>
        </a>
      )}
    </header>

    <section class="ss-levels" aria-label="Level select">
      <h2 class="ss-levels-head">Level Select</h2>
      <ol class="ss-level-list">
        {posts.map((p, i) => (
          <li class="ss-level">
            <a class="ss-level-link" href={p.href} style={`--lv:${p.topic?.color || p.accent}`}>
              <span class="ss-cursor" aria-hidden="true">
                <svg viewBox="0 0 12 12" width="13" height="13"><path d="M2 1l8 5-8 5z" fill="currentColor" /></svg>
              </span>
              <span class="ss-lv-num">LEVEL {pad2(i + 1)}</span>
              <span class="ss-lv-sep" aria-hidden="true">—</span>
              <span class="ss-lv-title">{p.title}</span>
              <span class="ss-lv-meta">{p.readMins} MIN</span>
            </a>
          </li>
        ))}
      </ol>
      <a class="ss-all" href={postsHref}>Continue → all {postsTitle.toLowerCase()}</a>
    </section>

    {liveTopics.length > 0 && (
      <div class="ss-worlds">
        <span class="ss-worlds-label">{topicsLabel}</span>
        <ul>
          {liveTopics.map((t) => (
            <li><a class="ss-world" href={t.href} style={`--lv:${t.color}`}>{t.name}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .ss {
    position: relative; background: #0b0f2a; overflow: hidden;
    min-height: calc(100vh - var(--header-h));
    padding: clamp(2rem, 6vh, 4.5rem) 0 3.5rem;
  }
  /* full-bleed CRT: scanlines + vignette, never intercepting clicks */
  .ss-crt {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.32) 0 2px, rgba(0, 0, 0, 0) 2px 4px),
      radial-gradient(125% 100% at 50% 42%, transparent 52%, rgba(0, 0, 0, 0.55) 100%);
  }
  .ss-inner { position: relative; z-index: 2; width: min(900px, 100% - 2.5rem); margin-inline: auto; }

  /* ---- hero ---- */
  .ss-hero { text-align: center; padding-block: clamp(1.5rem, 5vh, 3.5rem); }
  .ss-coin {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    text-transform: uppercase; letter-spacing: 0.32em; font-size: 0.82rem; color: #35e0ff;
  }
  .ss-wordmark {
    font-family: 'Fredoka', ui-monospace, system-ui, sans-serif; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.02em; line-height: 0.9;
    font-size: clamp(2.8rem, 12vw, 7rem); margin: 0.6rem 0 0; color: #ffcf33;
    text-shadow: 3px 0 0 #ff4d6d, -3px 0 0 #35e0ff, 0 4px 0 #0b0f2a, 0 7px 0 rgba(0, 0, 0, 0.55);
  }
  .ss-tagline {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 1rem; line-height: 1.5; color: #b8c4dd; margin: 1.1rem auto 0; max-width: 52ch;
  }

  /* ---- PRESS START featured (the latest post) ---- */
  .ss-start {
    display: inline-flex; flex-direction: column; align-items: center; gap: 0.4rem;
    margin-top: clamp(1.8rem, 5vh, 2.8rem); max-width: 100%;
    background: rgba(255, 207, 51, 0.08); border: 2px solid #ffcf33; border-radius: 2px;
    box-shadow: 5px 5px 0 #ff4d6d; padding: 1rem 1.5rem; cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .ss-start:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 #ff4d6d; background: rgba(255, 207, 51, 0.14); }
  .ss-start-blink {
    font-family: 'Fredoka', ui-monospace, system-ui, sans-serif; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em; font-size: 1.2rem; color: #ffcf33;
  }
  .ss-start-title { font-family: 'Fredoka', ui-monospace, system-ui, sans-serif; font-weight: 600; font-size: clamp(1.1rem, 3.2vw, 1.65rem); line-height: 1.1; color: #eafff5; }
  .ss-start-meta {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-variant-numeric: tabular-nums; font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase; color: #b8c4dd;
  }

  /* ---- LEVEL SELECT list (every post reachable) ---- */
  .ss-levels {
    margin-top: clamp(2.4rem, 6vh, 4rem);
    border: 3px solid rgba(120, 170, 255, 0.42); border-radius: 2px;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 2px, transparent 2px 4px),
      rgba(4, 6, 20, 0.72);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.5); padding: 1rem 0.6rem 1.2rem;
  }
  .ss-levels-head {
    font-family: 'Fredoka', ui-monospace, system-ui, sans-serif; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.95rem; color: #ffcf33; padding: 0.2rem 0.9rem 0.7rem;
  }
  .ss-level-list { list-style: none; margin: 0; padding: 0; }
  .ss-level-link {
    display: grid; grid-template-columns: 1.5rem auto auto minmax(0, 1fr) auto; align-items: baseline; gap: 0 0.6rem;
    padding: 0.62rem 0.9rem; cursor: pointer; border-left: 3px solid transparent;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    transition: background 0.18s ease, border-color 0.18s ease;
  }
  .ss-level-link:hover,
  .ss-level-link:focus-visible { background: rgba(255, 207, 51, 0.1); border-left-color: #ffcf33; }
  .ss-cursor { display: inline-flex; align-self: center; color: #ffcf33; opacity: 0; }
  .ss-level:first-child .ss-cursor { opacity: 1; }
  .ss-level-link:hover .ss-cursor,
  .ss-level-link:focus-visible .ss-cursor { opacity: 1; }
  .ss-lv-num { color: #ffcf33; font-weight: 700; letter-spacing: 0.05em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ss-lv-sep { color: #7f8fb5; }
  .ss-lv-title { color: #eafff5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .ss-level-link:hover .ss-lv-title,
  .ss-level-link:focus-visible .ss-lv-title { color: #ffcf33; }
  .ss-lv-meta { color: #7f8fb5; font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; }
  .ss-all {
    display: inline-block; margin: 1rem 0 0 0.9rem;
    font-family: 'Fredoka', ui-monospace, system-ui, sans-serif; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem; color: #35e0ff; cursor: pointer;
    transition: color 0.18s ease;
  }
  .ss-all:hover { color: #ffcf33; }

  /* ---- worlds (topics) HUD strip ---- */
  .ss-worlds { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.9rem; }
  .ss-worlds-label {
    width: 100%; font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.72rem; color: #7f8fb5;
  }
  .ss-worlds ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 0.6rem; }
  .ss-world {
    display: inline-flex; align-items: center;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: 0.82rem;
    text-transform: uppercase; letter-spacing: 0.04em; color: #eafff5;
    border: 2px solid rgba(120, 170, 255, 0.42); border-left: 3px solid var(--lv); border-radius: 2px;
    padding: 0.28em 0.7em; cursor: pointer; transition: border-color 0.18s ease, background 0.18s ease;
  }
  .ss-world:hover { border-color: #ffcf33; border-left-color: var(--lv); background: rgba(255, 207, 51, 0.08); }

  /* ---- motion: power-on, scanline roll, blinks. All OFF under reduced motion,
          which leaves static scanlines + a steady prompt + a steady cursor. ---- */
  @media (prefers-reduced-motion: no-preference) {
    .ss-crt { animation: ss-scan 8s linear infinite; }
    @keyframes ss-scan { to { background-position: 0 4px, 0 0; } }
    .ss-wordmark { animation: ss-poweron 0.9s steps(2, end) both; }
    @keyframes ss-poweron {
      0% { opacity: 0; }
      20% { opacity: 1; }
      32% { opacity: 0.3; }
      48% { opacity: 1; }
      64% { opacity: 0.55; }
      100% { opacity: 1; }
    }
    .ss-start-blink { animation: ss-blink 1.1s steps(1, end) infinite; }
    .ss-level:first-child .ss-cursor { animation: ss-blink 1s steps(1, end) infinite; }
    @keyframes ss-blink { 50% { opacity: 0; } }
  }

  @media (max-width: 560px) {
    .ss { min-height: calc(92vh - var(--header-h)); }
    .ss-level-link { grid-template-columns: 1.3rem auto minmax(0, 1fr) auto; }
    .ss-lv-sep { display: none; }
  }
</style>
