---
// A page built in Chapbook's page editor. The same renderer runs in the editor's preview.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { renderPage, PHONE_SIZES, photoSrcset, datesHrefOf } from '../lib/pages/render.mjs';
import { baseColours, blockPages } from '../lib/pages/site-pages';
import { site } from '../lib/site';
import { withBase } from '../lib/withBase';
import { formAddress } from '../lib/professional.mjs';
import { fmtDate } from '../lib/home';
import { postCover } from '../lib/post-cover.mjs';
import '../styles/blocks.css';
import '../styles/motion.css';
import '../styles/signature.css';
import profile from '../data/profile.json';
import { faqJsonLd, jsonLdText } from '../lib/business-schema.mjs';
const { page, title, description } = Astro.props;
// The starter's example form address and an empty one both mean there is no form.
const endpoint = formAddress((site as any).contact?.endpoint);
let blocks = page.blocks;
// A block Contact page always keeps a way to send a message.
const hasForm = blocks.some((b: any) => b.type === 'form' || (b.type === 'columns' && (b.data?.children || []).some((k: any) => k.type === 'form')));
if (page.slug === 'contact' && endpoint && !hasForm) {
  blocks = [...blocks, { id: 'contactform', type: 'form', variant: 'normal', style: {}, data: { heading: 'Send a message', button: 'Send message' } }];
}
let posts: any[] = [];
if (blocks.some((b: any) => b.type === 'posts')) {
  const coverModules = import.meta.glob('../content/blog/_images/**/*.{jpg,jpeg,png,webp,avif,gif,svg}', { eager: true, query: '?url', import: 'default' });
  const coverAssets = Object.fromEntries(Object.entries(coverModules).map(([path, url]) => [path.replace('../content/blog/', ''), url]));
  posts = (await getCollection('blog', ({ data }: any) => !data.draft))
    .sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 6)
    .map((p: any) => ({ href: withBase(`/blog/${p.slug}/`), title: p.data.title, description: p.data.description, dateLabel: fmtDate(p.data.date), image: postCover(p.data, p.body, coverAssets, import.meta.env.BASE_URL) }));
}
const html = renderPage({ ...page, blocks }, {
  site, posts, base: baseColours(), formEndpoint: endpoint,
  fallbackEmail: (profile as any).email && (profile as any).email !== 'you@example.com' ? (profile as any).email : '',
  href: (p: string) => withBase(p), postsHref: withBase('/posts/'),
  // A Thank you page's line to the dated classes, when the website has some (Add to calendar).
  datesHref: blocks.some((b: any) => b.role === 'thanks') ? datesHrefOf(blockPages, { site, href: (p: string) => withBase(p) }) : '',
});
// The opening's photo is the largest thing a phone paints first: it is asked for before the
// stylesheets are read, so the page's largest paint is not held up by them.
const opening = blocks.find((b: any) => b.type === 'hero');
const openingSrc = opening && !opening.data?.video && typeof opening.data?.picture?.src === 'string' ? opening.data.picture.src : '';
const preloadSrc = /^\/site-images\/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$/.test(openingSrc) ? withBase(openingSrc) : /^https:\/\//.test(openingSrc) ? openingSrc : '';
// With a phone copy, a phone asks for that one instead.
const openingPhone = preloadSrc && typeof opening.data?.picture?.phone === 'string' && /^\/site-images\/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$/.test(opening.data.picture.phone) ? withBase(opening.data.picture.phone) : '';
// The typefaces the first screen draws with, among those the site serves itself (the warm
// serifs, the rounded and the extra-clear sans: one file for each weight and style), are asked
// for at once, so the opening's words are not repainted late. Every other face of these is only
// asked for once the page has loaded (page-css.mjs moves its rule to the end, `cb-late`), so a
// phone's first screen does not wait for words further down. Inter and Space Grotesk are one
// file for every weight, which the first screen always needs: they are left as they are.
// The opening's heading face, and the face its marked word (*like this*) is set in.
const HEADING_FACES: Record<string, [string, string]> = {
  modern: ['fraunces-latin-600-normal', 'fraunces-latin-400-italic'],
  fine: ['fraunces-latin-400-normal', 'fraunces-latin-400-italic'],
  noir: ['fraunces-latin-900-italic', 'fraunces-latin-400-normal'],
  lyric: ['fraunces-latin-400-italic', 'fraunces-latin-400-normal'],
  editorial: ['newsreader-latin-600-normal', 'newsreader-latin-600-italic'],
  mixed: ['', 'newsreader-latin-400-italic'],
  friendly: ['fredoka-latin-600-normal', ''],
  quiet: ['newsreader-latin-400-normal', 'newsreader-latin-400-italic'],
};
// Running text, and its bolder weight for the small heading above (kicker) and the buttons.
const BODY_FACES: Record<string, string[]> = {
  easy: ['atkinson-hyperlegible-latin-400-normal', 'atkinson-hyperlegible-latin-700-normal'],
  reading: ['newsreader-latin-400-normal', 'newsreader-latin-600-normal'],
};
const look = (page as any).look || {};
const firstSection = (/<section\b[\s\S]*?<\/section>/.exec(html) || [''])[0];
const [headingFace, emFace] = HEADING_FACES[look.font] || ['', ''];
const firstFaces = [headingFace, firstSection.includes('<em>') ? emFace : '', ...(BODY_FACES[look.bodyFont] || [])].filter(Boolean);
const fontPreloads = [...new Set(firstFaces)].slice(0, 4).map((f) => withBase(`/fonts/${f}.woff2`));
// An About page whose blocks are all still empty would publish with nothing on it. It says one
// plain line instead and points to the Contact page. Nothing about the business is made up.
const blankAbout = page.slug === 'about' && !html.includes('<section');
// A page with questions and answers says so to search engines too.
const faqLd = faqJsonLd(blocks);
// A Thank you page (a section with the role `thanks`) is for people who have just paid: search
// engines are asked not to list it. (The design makes no sitemap, so nothing lists it there.)
const noindex = blocks.some((b: any) => b.role === 'thanks');
---
<Base title={title ?? page.title} description={description ?? (page.description || undefined)}>
  {/* Everything for the head in one place: several expressions naming the same slot keep only one. */}
  <Fragment slot="head">
    {noindex && <meta name="robots" content="noindex" />}
    {preloadSrc && (openingPhone
      ? <link rel="preload" as="image" href={preloadSrc} imagesrcset={photoSrcset({ ...opening.data.picture, src: preloadSrc, phone: openingPhone })} imagesizes={PHONE_SIZES} fetchpriority="high" />
      : <link rel="preload" as="image" href={preloadSrc} fetchpriority="high" />)}
    {fontPreloads.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  </Fragment>
  <slot />
  {faqLd && <script type="application/ld+json" set:html={jsonLdText(faqLd)} />}
  {/* Tell the stylesheet a script is on its way. Until it says so nothing on the page moves by
      itself (there would be no Pause button), and things that will arrive on scroll don't flash
      first. If the script never starts, the page goes back to plain and still within 3s. */}
  {/* The same for the booking bar and the order list (cba-js): they show from the first paint,
      and if their script never starts, their plain buttons come back within 3s. */}
  {/* What the first screen does not need waits until the page has loaded (page-css.mjs marks
      it): the typefaces only words further down use (`noscript[data-cb-late]`, whose rules are
      put back in a style after it), and the photos below the opening (`img[data-cb-src]`, given
      their addresses back, still loading lazily as they are scrolled near). After the load
      event, one frame more, so the first screen has been painted (a fast load can finish
      first). So a phone paints its first screen without sharing the line with them. Rerun
      after a page change, when the page has long since loaded. */}
  <script is:inline data-astro-rerun>document.documentElement.classList.add('cbm-js','cba-js');setTimeout(function(){if(!window.__cbm)document.documentElement.classList.remove('cbm-js');if(!window.__cba)document.documentElement.classList.remove('cba-js')},3000);(function(d){function late(){d.querySelectorAll('noscript[data-cb-late]').forEach(function(n){var s=n.nextElementSibling;if(s&&s.hasAttribute('data-cb-late-on'))return;s=d.createElement('style');s.setAttribute('data-cb-late-on','');s.textContent=n.textContent.replace(/<\/?style[^>]*>/g,'');n.after(s)});d.querySelectorAll('img[data-cb-src]').forEach(function(i){var a=i.getAttribute('data-cb-srcset');if(a)i.setAttribute('srcset',a);i.setAttribute('src',i.getAttribute('data-cb-src'));i.removeAttribute('data-cb-src');i.removeAttribute('data-cb-srcset')})}function soon(){requestAnimationFrame(function(){setTimeout(late,0)})}if(d.readyState==='complete')late();else addEventListener('load',soon,{once:true})})(document)</script>
  <Fragment set:html={html} />
  {blankAbout && (
    <div class="cbp"><section class="cb cb-t-text cb-text--plain cb-bg-none cb-w-normal cb-sp-m cb-al-left"><div class="cb-in">
      <p class="cb-kicker">About</p>
      {site.name && <h1 class="cb-h">{site.name}</h1>}
      <div class="cb-rich"><p>To find out more{site.name ? ` about ${site.name}` : ''}, please get in touch through the <a href={withBase('/contact/')}>Contact page</a>.</p></div>
    </div></section></div>
  )}
</Base>

<script>
  // Movement: things arriving on scroll, counting numbers, pointer effects and the Pause button.
  import { startPageMotion } from '../scripts/page-motion.js';
  startPageMotion();
  // The booking bar in the opening and the order list. Not movement: it runs for everyone.
  import { startPageActions } from '../scripts/page-actions.js';
  import { showCalendar, watchCalendar } from '../scripts/booking-calendar.js';
  startPageActions();

  // Block contact forms send without leaving the site and show the result in place.
  function bindBlockForms() {
    for (const form of document.querySelectorAll<HTMLFormElement>('.cbp .cb-form')) {
      const status = form.nextElementSibling as HTMLElement | null;
      if (form.dataset.bound || !status?.classList.contains('cb-form-status')) continue;
      form.dataset.bound = '1';
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const label = btn?.textContent || 'Send message';
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
        status.hidden = true;
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error('send');
          form.hidden = true;
          status.textContent = 'Thank you. Your message has been sent.';
        } catch {
          status.textContent = 'Your message could not be sent. Please try again, or use the email address on this page.';
          if (btn) { btn.disabled = false; btn.textContent = label; }
        }
        status.hidden = false;
      });
    }
  }
  bindBlockForms();
  document.addEventListener('astro:page-load', bindBlockForms);

  // Booking calendars load only when a visitor asks for them (scripts/booking-calendar.js).
  function bindBooking() {
    for (const box of document.querySelectorAll<HTMLElement>('.cbp .cb-booking-cal')) {
      const button = box.querySelector<HTMLButtonElement>('.cb-booking-load'), frame = box.querySelector<HTMLElement>('.cb-booking-frame'), status = box.querySelector<HTMLElement>('.cb-booking-status');
      if (!button || !frame || !status || box.dataset.bound) continue;
      box.dataset.bound = '1';
      button.addEventListener('click', async () => {
        const kind = box.dataset.bookingKind, src = box.dataset.bookingSrc || '';
        button.disabled = true; status.textContent = 'Loading the booking calendar…';
        // No calendar after about 5 seconds: the page says so, with the booking page and a call.
        const watch = watchCalendar(frame, status, box.querySelector('.cb-booking-fail'));
        try {
          if (kind === 'google' && /^https:\/\/calendar\.google\.com\/calendar\/appointments\/schedules\//.test(src)) {
            const f = document.createElement('iframe'); f.src = src; f.title = 'Booking calendar'; f.loading = 'lazy'; f.addEventListener('load', () => { f.dataset.loaded = '1'; });
            frame.replaceChildren(f); frame.dataset.kind = 'google';
          } else if (kind === 'cal') {
            // Each calendar on the page is its own (one per person, say), with its own light or dark setting.
            await showCalendar(frame, src, box);
          } else throw new Error('unknown');
          frame.hidden = false; button.hidden = true;
          if (!watch.showing()) status.textContent = 'Choose a time in the calendar. If it does not appear, use the link above.';
        } catch {
          // The fallback's words, with the call or email, say it (review, 23 Nov).
          button.disabled = false;
          watch.fail();
        }
      });
    }
  }
  bindBooking();
  document.addEventListener('astro:page-load', bindBooking);

  // Videos behind the opening words: a pause button, and no movement for people who ask for less.
  function bindHeroVideos() {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const v of document.querySelectorAll<HTMLVideoElement>('.cbp .cb-hero-bg video')) {
      const btn = v.closest('.cb')?.querySelector<HTMLButtonElement>('.cb-video-toggle');
      if (still) { v.pause(); v.removeAttribute('autoplay'); }
      if (!btn || btn.dataset.bound) continue;
      btn.dataset.bound = '1';
      const show = () => { btn.textContent = v.paused ? 'Play' : 'Pause'; btn.setAttribute('aria-label', v.paused ? 'Play the video' : 'Pause the video'); };
      btn.addEventListener('click', () => { if (v.paused) v.play().catch(() => {}); else v.pause(); show(); });
      v.addEventListener('play', show); v.addEventListener('pause', show); show();
    }
  }
  bindHeroVideos();
  document.addEventListener('astro:page-load', bindHeroVideos);
</script>
